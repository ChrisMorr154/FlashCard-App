<Window x:Class="FlashCardApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Flash Cards"
        Height="450"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FB">

    <Window.Resources>

        <!-- Styles for Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- Styles for Secondary buttons -->
        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">

            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E7EB"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D1D5DB"/>
                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- Flashcard text -->
        <Style x:Key="FlashcardText"
       TargetType="TextBlock">

            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10"/>

        </Style>


        <!-- Answer button -->
        <Style x:Key="AnswerButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">

            <Setter Property="Width" Value="170"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6"/>

        </Style>


        <!-- Import icon button -->
        <Style x:Key="ImportButton"
               TargetType="Button">

            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


    </Window.Resources>


    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Head -->

        <DockPanel Grid.Row="0"
                   Margin="0,0,0,12">

            <TextBlock Text="The Flash Card App"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#111827"/>

        </DockPanel>



        <!-- Main -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>

            </Grid.ColumnDefinitions>



            <!-- LEFT PANEL -->

            <Border Grid.Column="0"
                    CornerRadius="14"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="20"
                    Margin="0,0,10,0">


                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <!-- Card -->

                    <Border CornerRadius="12"
                            Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="20">


                        <TextBlock x:Name="TextBlockQuestionAnswer"
                                   Style="{StaticResource FlashcardText}"/>


                    </Border>



                    <!-- Bottom navigation -->

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,0">


                        <Button Content="Previous"
                                Width="90"
                                Style="{StaticResource SecondaryButton}"
                                Click="ButtonPrevious_Click"/>


                        <Button Content="Show Hint"
                                Width="100"
                                Style="{StaticResource SecondaryButton}"
                                Click="ButtonHint_Click"/>


                        <Button Content="Next"
                                Width="90"
                                Style="{StaticResource SecondaryButton}"
                                Click="ButtonNext_Click"/>


                    </StackPanel>


                </Grid>


            </Border>
            <!-- RIGHT PANEL -->

            <Border Grid.Column="1"
                    CornerRadius="14"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="16"
                    Margin="10,0,0,0">


                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>



                    <!-- Import Button -->

                    <Button Grid.Row="0"
                            Width="34"
                            Height="34"
                            Style="{StaticResource ImportButton}"
                            Click="ButtonImportCards_Click"
                            HorizontalAlignment="Left" Margin="176,0,0,0">

                        <Image Source="/assets/ImportIcon.png"
                               Width="18"
                               Height="18" RenderTransformOrigin="4.588,0.524"/>

                    </Button>



                    <!-- Deck Selector -->

                    <StackPanel Grid.Row="1"
                                Margin="0,20,0,0">


                        <TextBlock Text="Current Deck"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="6,0,0,5"/>


                        <ComboBox x:Name="ComboBoxDecks"
                                  Height="32"
                                  Margin="6,0,6,0"
                                  SelectionChanged="ComboBoxDecks_SelectionChanged"/>
                    </StackPanel>

                    <Button
                        Grid.Row="2"
                        Content="Shuffle"
                        Style="{StaticResource AnswerButton}"
                        Width="100"
                        Click="ButtonImportCards_Click"
                        HorizontalAlignment="Center" Height="33"/>



                    <!-- Show Answer Button -->

                    <Button Grid.Row="3"
                            Content="Flip Card"
                            Style="{StaticResource AnswerButton}"
                            Click="ButtonAnswer_Click"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"/>


                </Grid>


            </Border>


        </Grid>



        <!-- Footer -->

        <TextBlock Grid.Row="2"
                   Text="If this application helped you, please star the repository."
                   FontSize="11"
                   Foreground="#6B7280"
                   Margin="2,12,2,0"
                   HorizontalAlignment="Center"/>


    </Grid>


</Window>