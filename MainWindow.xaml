<Window x:Class="FlashCardApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        ResizeMode="CanMinimize" 
        Title="Flash Cards"
        FontFamily="Arial"
        FontSize="20"
        Height="450"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#FAF8F3">

    <Window.Resources>

        <!-- Styles for Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- Styles for Secondary buttons -->
        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">

            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E7EB"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D1D5DB"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- Dark primary button -->
        <Style x:Key="DarkPrimaryButton" TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>


            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#64748B"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <Style x:Key="DarkImportButton"
       TargetType="Button">

            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>


            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="21">

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>


            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>


                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>


            </Style.Triggers>

        </Style>

        <Style x:Key="DropDownBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}"/>

                                    <ToggleButton
                                Grid.Column="1"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <TextBlock Text="▼"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup
                        IsOpen="{TemplateBinding IsDropDownOpen}"
                        Placement="Bottom"
                        AllowsTransparency="True"
                        Focusable="False">

                                <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">

                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>

                                </Border>

                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border"
                                Property="Background"
                                Value="SlateGray"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Border"
                                Property="BorderBrush"
                                Value="#3B82F6"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Flashcard text -->
        <Style x:Key="FlashcardText"
       TargetType="TextBlock">

            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10"/>

        </Style>


        <!-- Answer button -->
        <Style x:Key="AnswerButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">

            <Setter Property="Width" Value="170"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6"/>

        </Style>


        <!-- Import icon button -->
        <Style x:Key="ImportButton"
               TargetType="Button">

            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D1D5DB"/>
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D1D5DB"/>
                </Trigger>
            </Style.Triggers>

        </Style>


    </Window.Resources>


    <Grid Margin="20">


        <Grid x:Name="MainContent">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- Head -->

            <DockPanel Grid.Row="0"
                Margin="0,0,0,12"/>



            <!-- Main -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>

                </Grid.ColumnDefinitions>



                <!-- LEFT PANEL -->

                <Border 
                    x:Name="LeftPanel"
                    Grid.Column="0"
                    CornerRadius="14"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="20"
                    Margin="0,0,10,0">


                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>



                        <!-- Card -->

                        <Border 
                            x:Name="RealCard"
                            CornerRadius="12"
                            Background="#F9FAFB"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            Padding="20" Margin="0,0,0,133">


                            <TextBlock x:Name="Card"
                                Style="{StaticResource FlashcardText}"/>


                        </Border>



                        <!-- Bottom navigation -->

                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,201,0,22">


                            <Button Content="Previous"
                                Width="100"
                                Height="58"
                                FontSize="20"
                                Style="{StaticResource AnswerButton}"
                                Click="ButtonPrevious_Click"/>


                            <Button Width="100"
                                Height="73"
                                Style="{StaticResource AnswerButton}"
                                Click="ButtonHint_Click"
                                FontSize="20"
                                FontFamily="Arial">

                                <TextBlock TextAlignment="Center" FontWeight="Bold"><Run Text="Show"/><LineBreak/><Run Text="Hint"/></TextBlock>

                            </Button>

                            <Button Content="Next"
                                Width="100"
                                Height="58"
                                FontSize="20"
                                Style="{StaticResource AnswerButton}"
                                Click="ButtonNext_Click"/>
                        </StackPanel>


                    </Grid>


                </Border>
                <!-- RIGHT PANEL -->

                <Border 
                    x:Name="RightPanel"
                    Grid.Column="1"
                    CornerRadius="14"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    Padding="16"
                    Margin="10,0,0,0">


                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>



                        <!-- Import Button -->

                        <Button 
                            x:Name="ImportBorder"
                            Grid.Row="0"
                            Width="50"
                            Height="50"
                            Style="{StaticResource ImportButton}"
                            Click="ButtonImportCards_Click"
                            HorizontalAlignment="Left" Margin="10,25,0,90" RenderTransformOrigin="0.467,-2.4">

                            <Image Source="/assets/Import(dark).png"
                                Width="30"
                                Height="30" RenderTransformOrigin="4.588,0.524"/>

                        </Button>

                        <!-- shuffle Button -->
                        <Button 
                            x:Name="ShuffleBorder"
                            Grid.Row="0"
                            Width="50"
                            Height="50"
                            Style="{StaticResource ImportButton}"
                            Click="ButtonShuffle_Click"
                            HorizontalAlignment="Center" Margin="0,25,0,90" RenderTransformOrigin="-0.06,0.481">

                            <Image Source="/assets/shuffle.png"
                                Width="30"
                                Height="30" RenderTransformOrigin="4.588,0.524"/>

                        </Button>

                        <!-- settings Button -->
                        <Button 
                            x:Name="SettingBorder"
                            Grid.Row="0"
                            Width="50"
                            Height="50"
                            Style="{StaticResource ImportButton}"
                            Click="ButtonSettings_Click"
                            HorizontalAlignment="Left" Margin="160,24,0,91">

                            <Image Source="/assets/settings(dark).png"
                                Width="30"
                                Height="30" RenderTransformOrigin="4.588,0.524"/>

                        </Button>



                        <!-- Deck Selector -->
                        <StackPanel
                            x:Name="DeckSelect"
                            Margin="0,102,0,104" Grid.RowSpan="3">
                            <TextBlock 
                                x:Name="DropDownName"
                                Text="Decks"
                                FontWeight="SemiBold"
                                Foreground="Black"
                                Margin="6,0,0,5"/>
                            <ComboBox 
                                x:Name="ComboBoxDecks"
                                Style="{StaticResource DropDownBox}"
                                Height="25"
                                Margin="6,0,6,0"
                                SelectionChanged="ComboBoxDecks_SelectionChanged" FontWeight="Bold" Opacity="1.5">
                                <ComboBox.Background>
                                    <LinearGradientBrush EndPoint="0,1">
                                        <GradientStop Color="White"/>
                                    </LinearGradientBrush>
                                </ComboBox.Background>
                                <ComboBox.Effect>
                                    <DropShadowEffect/>
                                </ComboBox.Effect>
                            </ComboBox>
                        </StackPanel>

                        <!-- Show Answer Button -->
                        <Button Grid.Row="2"
                            Content="Flip Card"
                            Style="{StaticResource AnswerButton}"
                            Click="ButtonAnswer_Click"
                            HorizontalAlignment="Center" FontFamily="Arial" FontWeight="Bold" FontSize="20"/>


                    </Grid>


                </Border>


            </Grid>



            <!-- Footer -->

            <TextBlock Grid.Row="2"
                Text="Please support by starring the repository."
                FontSize="12"
                Foreground="#6B7280"
                Margin="2,12,2,0"
                HorizontalAlignment="Center"/>


        </Grid>

        <Grid x:Name="Overlay"
          Background="#66000000"
          Visibility="Collapsed"/>

        <!-- setting slide panel -->
        <Border x:Name="SettingsPanel"
            Width="320"
            HorizontalAlignment="Left"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            Padding="20" Margin="360,0,0,0">

            <Border.RenderTransform>
                <TranslateTransform
                x:Name="SettingsTransform"
                X="320"/>
            </Border.RenderTransform>

            <StackPanel>

                <TextBlock Text="Settings"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

                <Border Width="220"
                        Height="45"
                        CornerRadius="12"
                        Background="#E8EEF2"
                        BorderBrush="#B7C8D6"
                        BorderThickness="1"
                        Margin="0,10">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- Divider -->
                        <Border Grid.Column="1"
                                Width="1"
                                Background="#B7C8D6"
                                HorizontalAlignment="Left"/>

                        <!-- Light -->
                        <Button x:Name="ButtonLight"
                                Grid.Column="0"
                                Click="ButtonLight_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">

                            <TextBlock x:Name="LightToggle"
                                       Text="Light"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="black"/>
                        </Button>

                        <!-- Dark -->
                        <Button x:Name="ButtonDark"
                                Grid.Column="1"
                                Click="ButtonDark_Click"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">

                            <TextBlock x:Name="DarkToggle"
                                       Text="Dark"
                                       FontSize="15"
                                       FontWeight="Normal"
                                       Opacity="0.55"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="Black"/>
                        </Button>

                    </Grid>

                </Border>

                <Button Content="Close"
                        Width="100"
                        Click="CloseSettings_Click"/>

            </StackPanel>

        </Border>


    </Grid>


</Window>